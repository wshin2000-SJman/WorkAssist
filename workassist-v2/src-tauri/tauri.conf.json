{
  "productName": "WorkAssist",
  "version": "2.1.1",
  "identifier": "com.sjautomation.workassist",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": null,
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkAssist v2.1.1",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "transparent": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https:; connect-src 'self' ipc.localhost;"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/jre": "bin/jre",
      "bin/opendataloader-pdf-cli.jar": "bin/opendataloader-pdf-cli.jar",
      "../scripts/order_template.xlsx": "scripts/order_template.xlsx"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["Korean"]
      }
    }
  }
}
